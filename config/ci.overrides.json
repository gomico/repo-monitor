{
  "repos_root": "data/repos",
  "counter_script": "tools/zh-refresh-wordcount/count_zh_refresh.py",
  "python_exe": "",
  "repo_source": "remote",
  "mirrors_root": "data/mirrors",
  "tool_cache_root": "data/toolcache",
  "runtime": {
    "concurrency": 1,
    "fetch_timeout_s": 300,
    "compare_timeout_s": 900,
    "keep_raw_days": 7,
    "keep_detail_days": 14
  },
  "publish": {
    "enabled": true,
    "method": "git",
    "target": "site",
    "remote": "origin",
    "branch": "gh-pages",
    "files": [
      "latest"
    ],
    "commit_message": "report: {date} ({generated_at})",
    "timeout_s": 180,
    "on_error": "warn",
    "retry_delays_s": [
      60,
      180
    ]
  }
}
